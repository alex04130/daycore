# 默认：由 git 判断文本/二进制，文本一律以 LF 存入仓库
* text=auto eol=lf

# ── 源码：强制 LF（避免 WSL ↔ Windows 协作时整文件 diff）──
*.go      text eol=lf diff=golang
*.js      text eol=lf
*.jsx     text eol=lf
*.mjs     text eol=lf
*.css     text eol=lf
*.html    text eol=lf
*.json    text eol=lf
*.yaml    text eol=lf
*.yml     text eol=lf
*.md      text eol=lf
*.tmpl    text eol=lf
*.ics     text eol=lf
Makefile  text eol=lf
Dockerfile text eol=lf
*.conf    text eol=lf

# ── 二进制：不做换行转换、不做 diff ──
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.woff    binary
*.woff2   binary
*.ttf     binary
*.zip     binary

# ── 生成/vendor 文件：不计入语言统计，diff 折叠 ──
web/frontend/src/vendor/ds-bundle.js  linguist-vendored -diff
web/frontend/src/ds/_ds_bundle.css    linguist-vendored -diff
web/frontend/package-lock.json        linguist-generated -diff

# ── 许可证：不计入语言统计 ──
COPYING         linguist-vendored
COPYING.LESSER  linguist-vendored

# ── Daycore v2 environment ──────────────────────────────────────────────────
# Copy to .env and adjust. Real environment variables always override .env.

# Server
APP_ENV=development            # development | production
HOST=                          # listen interface; empty = all. Behind nginx use 127.0.0.1
PORT=8080
# Frontend build served by Go at "/" (SPA fallback). Missing dir = API-only
# (e.g. during `npm run dev`, which proxies /api to this server instead).
STATIC_DIR=web/frontend/dist
PUBLIC_BASE_URL=http://localhost:8080   # set to https://your.domain in production (OAuth callbacks)
# Comma-separated CORS allowlist for a separately-hosted frontend (dev only).
# Leave empty when nginx serves the frontend same-origin.
ALLOWED_ORIGINS=

# ── Language ────────────────────────────────────────────────────────────────
# Each USER picks their own two languages on the settings page — one main, one
# to fall back on — and every frontend's home page switches between those two.
# These are only the DEFAULTS for someone who has not chosen yet; they do not
# restrict what anyone may pick. A bad value fails the boot rather than silently
# starting every new user in the wrong language.
DEFAULT_PRIMARY_LOCALE=zh-CN
# Leave empty to start users with no switch; they can still add a second later.
DEFAULT_SECONDARY_LOCALE=en-US
# Message packs: <locale>.json files, flat {"key": "text"}. Dropping one in adds
# a language WITHOUT a rebuild — only zh-CN and en-US are compiled in, and they
# are a floor, not the set of languages supported. Resolution is
# database → these files → compiled-in. Export a starting point for a new
# translation from the admin console.
LOCALES_DIR=locales

# ── Database ────────────────────────────────────────────────────────────────
# DB_TYPE selects the registered driver: sqlite | postgres | mysql | mongodb
DB_TYPE=sqlite
# SQLite (default — zero external services, single-file deploy):
DB_DSN=file:daycore.db?_pragma=busy_timeout(5000)&_pragma=journal_mode(WAL)
# PostgreSQL:  DB_DSN=postgres://user:pass@localhost:5432/daycore?sslmode=disable
# MySQL:       DB_DSN=user:pass@tcp(localhost:3306)/daycore?charset=utf8mb4&parseTime=true
# The server appends the connection settings it depends on if you leave them out
# — clientFoundRows=true on MySQL, busy_timeout + WAL on SQLite. You do not have
# to copy them; you cannot break them by forgetting them.
# MongoDB:     DB_DSN=mongodb://localhost:27017/daycore

# ── Auth ────────────────────────────────────────────────────────────────────
# Generate strong values in production (e.g. `openssl rand -hex 32`).
JWT_SECRET=
COOKIE_SECRET=
PASSWORD_PEPPER=                # optional extra server-side secret for hashing
JWT_TTL=720h
SECURE_COOKIES=false           # true behind HTTPS / in production

# ── AI ──────────────────────────────────────────────────────────────────────
MODELS_CONFIG=config/models.yaml
OAUTH_CONFIG=config/oauth.yaml
DEFAULT_CHAT_MODEL=deepseek-chat   # must match an id in models.yaml
DEFAULT_VISION_MODEL=              # empty = first vision-capable model in the catalog
DEFAULT_PLANNER_MODEL=             # model for auto-plan (e.g. deepseek-reasoner); empty = chat model
AI_REQUEST_TIMEOUT=120s
AGENT_MAX_ROUNDS=6                 # companion agent tool rounds per message

# API keys referenced by models.yaml (api_key_env):
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Web search for the companion agent (optional; falls back to DuckDuckGo):
TAVILY_API_KEY=

# ── Limits / admin ──────────────────────────────────────────────────────────
AI_RATE_LIMIT_PER_MIN=30
MAX_IMAGE_BYTES=8388608
ADMIN_TOKEN=                    # required to edit prompts; empty = open in dev only

# ── Autonomous planning ─────────────────────────────────────────────────────
AUTO_PLAN_MAX_DAYS=7            # largest date range one /api/ai/auto-plan call covers
ASSIGNMENT_LOOKAHEAD_DAYS=14    # how far ahead assignments count as "upcoming" in AI context

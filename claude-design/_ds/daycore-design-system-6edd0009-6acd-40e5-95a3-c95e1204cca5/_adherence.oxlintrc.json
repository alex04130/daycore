      {
        "selector": "JSXOpeningElement[name.name='ThemeSwitcher'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:icon|pill)$/]",
        "message": "<ThemeSwitcher> variant must be one of 'icon' | 'pill'."

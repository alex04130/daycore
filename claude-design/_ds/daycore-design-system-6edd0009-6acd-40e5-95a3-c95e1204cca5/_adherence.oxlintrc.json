      {
        "selector": "JSXOpeningElement[name.name='Textarea'] > JSXAttribute > JSXIdentifier[name!=/^(?:invalid|className|id|style|children|key|ref|className|style|children)$/]",
        "message": "<Textarea> doesn't accept that prop. Declared props: invalid, className, id, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='ThemeProvider'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|defaultTheme|theme|onThemeChange|target|storageKey|className|key|ref|className|style|children)$/]",
        "message": "<ThemeProvider> doesn't accept that prop. Declared props: children, defaultTheme, theme, onThemeChange, target, storageKey, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='ThemeProvider'] > JSXAttribute[name.name='defaultTheme'] > Literal[value!=/^(?:sky|sunset|night|nature)$/]",
        "message": "<ThemeProvider> defaultTheme must be one of 'sky' | 'sunset' | 'night' | 'nature'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ThemeProvider'] > JSXAttribute[name.name='theme'] > Literal[value!=/^(?:sky|sunset|night|nature)$/]",
        "message": "<ThemeProvider> theme must be one of 'sky' | 'sunset' | 'night' | 'nature'."
